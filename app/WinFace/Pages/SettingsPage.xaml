<UserControl x:Class="WinFace.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" />
      <TextBlock Text="Changes apply the next time the lock screen appears." Style="{StaticResource Sub}" Margin="0,0,0,22" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Camera" Style="{StaticResource H2}" />
          <TextBlock Text="Only real USB / built-in cameras can be used; virtual cameras are always refused." Style="{StaticResource Sub}" Margin="0,4,0,10" />
          <ListBox x:Name="Cameras" Style="{StaticResource PickList}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Recognition" Style="{StaticResource H2}" />
          <TextBlock Text="Strictness" Style="{StaticResource Body}" Margin="0,14,0,6" />
          <Border Style="{StaticResource SegBar}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="StrictBalanced" Style="{StaticResource Seg}" GroupName="strict" Content="Balanced" />
              <RadioButton x:Name="StrictStrict" Style="{StaticResource Seg}" GroupName="strict" Content="Strict" />
              <RadioButton x:Name="StrictRelaxed" Style="{StaticResource Seg}" GroupName="strict" Content="Relaxed" />
            </StackPanel>
          </Border>
          <TextBlock Text="Balanced suits most people. Strict if someone who looks like you shares the PC; Relaxed if it often fails to recognise you."
                     Style="{StaticResource Sub}" Margin="0,6,0,0" />

          <DockPanel Margin="0,18,0,4">
            <TextBlock x:Name="SearchVal" DockPanel.Dock="Right" Style="{StaticResource Sub}" />
            <TextBlock Text="Time to find your face" Style="{StaticResource Body}" />
          </DockPanel>
          <Slider x:Name="Search" Minimum="3" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True" />

          <DockPanel Margin="0,14,0,4">
            <TextBlock x:Name="ChallengeVal" DockPanel.Dock="Right" Style="{StaticResource Sub}" />
            <TextBlock Text="Time for the head turn" Style="{StaticResource Body}" />
          </DockPanel>
          <Slider x:Name="Challenge" Minimum="2" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" />

          <TextBlock Text="Failed attempts before only PIN / password is offered" Style="{StaticResource Body}" Margin="0,18,0,6" />
          <Border Style="{StaticResource SegBar}">
            <StackPanel x:Name="Fails" Orientation="Horizontal" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Sound" Style="{StaticResource H2}" />
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Play" Click="OnPlay" Padding="12,5" FontSize="12.5" />
            <CheckBox x:Name="Sounds" Style="{StaticResource Switch}">
              <TextBlock Text="Play a sound when face unlock succeeds" Style="{StaticResource Body}" />
            </CheckBox>
          </DockPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal">
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" Click="OnSave" />
        <TextBlock x:Name="SaveText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
