<UserControl x:Class="WinFace.Pages.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Password" Style="{StaticResource H1}" />
      <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22"
                 Text="Windows needs your account password to sign you in after your face is recognised. WinFace stores it encrypted by your PC's TPM chip, readable only by the lock screen. It is never shown or logged." />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="StateText" Text="Checking..." Style="{StaticResource Body}" VerticalAlignment="Center" />
          </DockPanel>
          <Button x:Name="VerifyButton" Content="Check the saved password with Windows" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnVerify" />
          <TextBlock x:Name="VerifyText" Style="{StaticResource Sub}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="FormTitle" Text="Save your password" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,14"
                     Text="Your Windows / Microsoft account password - not your PIN. Update it here whenever you change your password." />
          <TextBlock Text="Password" Style="{StaticResource Sub}" Margin="0,0,0,4" />
          <PasswordBox x:Name="Pw1" Width="320" HorizontalAlignment="Left" />
          <TextBlock Text="Again" Style="{StaticResource Sub}" Margin="0,12,0,4" />
          <PasswordBox x:Name="Pw2" Width="320" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" Click="OnSave" />
            <TextBlock x:Name="SaveText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
