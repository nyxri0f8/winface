<UserControl x:Class="WinFace.Pages.FacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinFace">
  <Grid>
    <!-- list -->
    <ScrollViewer x:Name="ListPane" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Faces" Style="{StaticResource H1}" />
        <TextBlock Text="Up to 3 faces, for example one with glasses. Updating a face captures it again from scratch."
                   Style="{StaticResource Sub}" Margin="0,0,0,22" />

        <Border Style="{StaticResource Card}" Padding="8">
          <StackPanel>
            <StackPanel x:Name="FaceList" />
            <TextBlock x:Name="Empty" Text="No faces yet. Add yours below." Style="{StaticResource Sub}" Margin="12,14" />
          </StackPanel>
        </Border>

        <Border x:Name="AddCard" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Add a face" Style="{StaticResource H2}" />
            <TextBlock Text="Sit about an arm's length from the camera in normal light. It takes about 30 seconds."
                       Style="{StaticResource Sub}" Margin="0,4,0,14" />
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="NameBox" Width="260" MaxLength="32" />
              <Button Content="Start" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="OnAdd" />
            </StackPanel>
            <TextBlock Text="Name (for you only), e.g. &quot;me&quot; or &quot;glasses&quot;" Style="{StaticResource Sub}" FontSize="12" Margin="2,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- enrolment -->
    <Grid x:Name="EnrollView" Visibility="Collapsed" Margin="36,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="EnrollTitle" Text="Adding face" Style="{StaticResource H1}" />
        <TextBlock Text="Only the landmark dots are shown. No camera image is displayed or stored." Style="{StaticResource Sub}" />
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <local:MeshView x:Name="Mesh" MinHeight="260" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
          <TextBlock x:Name="Say" Text="Starting camera..." Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap" />
          <TextBlock x:Name="Msg" Text="" Style="{StaticResource Sub}" FontSize="14" Margin="0,8,0,20" />
          <StackPanel x:Name="PoseList" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="EnrollButton" Content="Cancel" Click="OnCancel" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
