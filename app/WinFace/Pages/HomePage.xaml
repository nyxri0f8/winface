<UserControl x:Class="WinFace.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Home" Style="{StaticResource H1}" />
      <TextBlock Text="Sign in to Windows by looking at your camera." Style="{StaticResource Sub}" Margin="0,0,0,22" />

      <!-- hero: current state + mode switch -->
      <Border Style="{StaticResource Card}" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource Surface2}" VerticalAlignment="Top">
            <TextBlock x:Name="HeroIcon" Style="{StaticResource Icon}" FontSize="30" Text="&#xE77B;" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock x:Name="HeroTitle" Text="Checking..." Style="{StaticResource H2}" FontSize="20" />
            <TextBlock x:Name="HeroSub" Text="" Style="{StaticResource Sub}" Margin="0,4,0,16" />
            <Border Style="{StaticResource SegBar}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeOff" Style="{StaticResource Seg}" GroupName="mode" Content="Off" Click="OnMode" Tag="off" />
                <RadioButton x:Name="ModeTest" Style="{StaticResource Seg}" GroupName="mode" Content="Test prompt only" Click="OnMode" Tag="test" />
                <RadioButton x:Name="ModeLock" Style="{StaticResource Seg}" GroupName="mode" Content="Lock screen" Click="OnMode" Tag="lock" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Sub}" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{StaticResource Warn}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- setup checklist -->
      <!-- paused / camera changed -->
      <Border x:Name="AlertCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Open Security" Click="OnSecurity" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" FontSize="20" Margin="0,0,14,0" />
          <StackPanel>
            <TextBlock x:Name="AlertTitle" Style="{StaticResource H2}" />
            <TextBlock x:Name="AlertText" Style="{StaticResource Sub}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="SetupCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Finish setting up" Style="{StaticResource H2}" />
          <TextBlock Text="A few steps, once. Your PIN and password always keep working." Style="{StaticResource Sub}" Margin="0,4,0,12" />
          <StackPanel x:Name="Steps" />
        </StackPanel>
      </Border>

      <!-- system checks -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Check again" Click="OnRecheck" Padding="12,5" FontSize="12.5" />
            <TextBlock Text="System checks" Style="{StaticResource H2}" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel x:Name="Checks" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <!-- privacy + disable / erase -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource Good}" />
            <TextBlock Text="Privacy and your data" Style="{StaticResource H2}" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                     Text="Everything stays on this PC. WinFace never uploads anything: no account, no cloud, no telemetry. Camera images are never saved (except intruder photos, if you turn them on) - only face templates (numbers) in C:\ProgramData\WinFace, readable only by administrators. Your password is encrypted by this PC's TPM chip." />
          <WrapPanel Margin="0,14,0,0">
            <Button Content="Turn face unlock off" Click="OnOff" Margin="0,0,8,8" />
            <Button Content="Erase all face data..." Style="{StaticResource DangerButton}" Click="OnErase" Margin="0,0,8,8" />
            <Button Content="Open setup guide" Click="OnGuide" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock x:Name="EraseText" Style="{StaticResource Sub}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
