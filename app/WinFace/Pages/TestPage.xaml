<UserControl x:Class="WinFace.Pages.TestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinFace">
  <Grid Margin="36,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Test" Style="{StaticResource H1}" />
      <TextBlock Text="Runs the same face check as the lock screen, including the head turn. It never signs anyone in."
                 Style="{StaticResource Sub}" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <local:MeshView x:Name="Mesh" MinHeight="260" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock x:Name="Arrow" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />
        <TextBlock x:Name="Hint" Text="Press Start and look at the camera." Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Style="{StaticResource Sub}" FontSize="14" Margin="0,8,0,0" />
        <TextBlock x:Name="Numbers" Style="{StaticResource Sub}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="StartButton" Content="Start" Style="{StaticResource AccentButton}" Click="OnStart" />
    </StackPanel>
  </Grid>
</UserControl>
