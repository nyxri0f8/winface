<Window x:Class="WinFace.PolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFace - privacy policy and warning" Width="720" Height="680" MinWidth="560" MinHeight="480"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Ui}" Icon="winface.png"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="The privacy policy and warning were updated" Style="{StaticResource H2}" FontSize="20" />
      <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,14"
                 Text="Please read what changed (optional intruder photos, the screen-flash check, the PIN rules and the update check) and agree to keep using WinFace." />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="4">
      <TextBox x:Name="Policy" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" Background="Transparent" BorderThickness="0"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Border>
    <Border Grid.Row="2" Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,12" Margin="0,16,0,16">
      <CheckBox x:Name="Agree" Style="{StaticResource Switch}" Click="OnAgree">
        <TextBlock Text="I have read and agree to the privacy policy and the warning" Style="{StaticResource Body}" FontWeight="SemiBold" />
      </CheckBox>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Close WinFace" Click="OnQuit" Margin="0,0,8,0" />
      <Button x:Name="Continue" Content="Continue" Style="{StaticResource AccentButton}" IsEnabled="False" Click="OnContinue" MinWidth="120" />
    </StackPanel>
  </Grid>
</Window>
