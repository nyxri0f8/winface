<Window x:Class="WinFaceUpdater.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFace update" Width="620" Height="600" MinWidth="480" MinHeight="420"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Ui}" Icon="winface.png"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Image Source="winface.png" Width="52" Height="52" />
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="20" />
        <TextBlock x:Name="Sub" Style="{StaticResource Sub}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="NotesPanel" />
      </ScrollViewer>
    </Border>

    <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
      <ProgressBar x:Name="Bar" Height="6" Maximum="1" Foreground="{StaticResource Accent}" Background="{StaticResource Surface2}" BorderThickness="0" />
      <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}" Margin="0,6,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip this version" Style="{StaticResource LinkButton}" Click="OnSkip" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LaterButton" Content="Later" Click="OnLater" Margin="0,0,8,0" />
        <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource AccentButton}" Click="OnUpdate" MinWidth="130" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
